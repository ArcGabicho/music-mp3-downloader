<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Solo Windows: la app es de bandeja (WinUI + H.NotifyIcon.Maui). Este TFM no
         compila en hosts que no son Windows — el XAML nativo de Platforms/Windows/App.xaml
         pasa por XamlCompiler.exe (WindowsAppSDK), un binario de Windows; EnableWindowsTargeting
         solo habilita el *restore*, no la compilación. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MusicMp3Downloader.App</RootNamespace>
    <AssemblyName>MusicMp3Downloader.App</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Music MP3 Downloader</ApplicationTitle>
    <ApplicationId>com.arcgabicho.musicmp3downloader</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Sin empaquetar: publicación como carpeta autónoma, sin MSIX. -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- Core vive en Core/ dentro de este mismo directorio de proyecto: el globbing por
       defecto del SDK (Compile/Content/None/EmbeddedResource) es recursivo y, sin esto,
       incluiría también los .cs de Core (y hasta su obj/ generado) como si fueran de
       App, duplicando tipos y atributos de ensamblado. -->
  <ItemGroup>
    <Compile Remove="Core\**" />
    <Content Remove="Core\**" />
    <EmbeddedResource Remove="Core\**" />
    <None Remove="Core\**" />
  </ItemGroup>

  <!-- ============ Herramientas externas empaquetadas (yt-dlp + ffmpeg + deno) ============ -->
  <PropertyGroup>
    <BundleExternalTools Condition="'$(BundleExternalTools)' == ''">true</BundleExternalTools>
    <ExternalToolsRid>win-x64</ExternalToolsRid>
    <ExternalToolsSourceRoot>$(MSBuildProjectDirectory)/Tools</ExternalToolsSourceRoot>
    <ExternalToolsDir>$(ExternalToolsSourceRoot)/$(ExternalToolsRid)</ExternalToolsDir>
  </PropertyGroup>

  <Target Name="FetchExternalTools"
          BeforeTargets="Build;Publish"
          Condition="'$(BundleExternalTools)' == 'true' and '$(ExternalToolsRid)' != ''">
    <!-- Cada Exec comprueba yt-dlp, ffmpeg y deno por separado: si uno de ellos no se
         descargó (p. ej. por un fallo de red puntual), reintenta en el próximo build
         en vez de darlo por "ya resuelto" solo porque los otros binarios sí existen. -->
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/yt-dlp')"
          Command="bash &quot;$(ExternalToolsSourceRoot)/fetch-tools.sh&quot; $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/ffmpeg')"
          Command="bash &quot;$(ExternalToolsSourceRoot)/fetch-tools.sh&quot; $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/yt-dlp.exe')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ExternalToolsSourceRoot)\fetch-tools.ps1&quot; -Rid $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/ffmpeg.exe')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ExternalToolsSourceRoot)\fetch-tools.ps1&quot; -Rid $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/deno')"
          Command="bash &quot;$(ExternalToolsSourceRoot)/fetch-tools.sh&quot; $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/deno.exe')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ExternalToolsSourceRoot)\fetch-tools.ps1&quot; -Rid $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="CopyExternalToolsToOutput" AfterTargets="Build" DependsOnTargets="FetchExternalTools" Condition="'$(BundleExternalTools)' == 'true' and Exists('$(ExternalToolsDir)')">
    <ItemGroup>
      <_ExternalToolFile Include="$(ExternalToolsDir)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExternalToolFile)" DestinationFolder="$(OutDir)tools"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyExternalToolsToPublish"
          AfterTargets="Publish"
          DependsOnTargets="FetchExternalTools"
          Condition="'$(BundleExternalTools)' == 'true' and Exists('$(ExternalToolsDir)')">
    <ItemGroup>
      <_ExternalToolFile Include="$(ExternalToolsDir)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExternalToolFile)" DestinationFolder="$(PublishDir)tools"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\favicon.svg" Color="#0C0C0F" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0C0C0F" BaseSize="128,128" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- El glob de MAUI para su propio mecanismo de "CSS para controles nativos" (MauiCss)
       reclama *.css sin distinguir el CSS isolation de Blazor (*.razor.css); además, a
       diferencia de un proyecto Razor/Web normal, MAUI no agrega los .razor.css al item
       Content por su cuenta (de ahí sale @(ScopedCssInput)). Sin ambas líneas, el bundle
       de estilos con scope de cada componente nunca se genera y la UI se renderiza sin
       ningún estilo. -->
  <ItemGroup>
    <MauiCss Remove="**\*.razor.css" />
    <Content Include="**\*.razor.css" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
  </ItemGroup>

  <!-- Ícono de bandeja del sistema. TrayIconView es una vista de MAUI (usa
       H.NotifyIcon.Maui), no de WinUI, así que NO puede vivir bajo Platforms/Windows/: el
       SDK de MAUI quita incondicionalmente todo .xaml bajo esa carpeta del item MauiXaml
       (asume que es XAML nativo de WinUI para XamlCompiler.exe, como App.xaml) — si se la
       deja ahí, XamlCompiler.exe intenta compilarla y falla en silencio (exit code 1, sin
       mensaje). Por eso vive en Views/ junto al resto de páginas MAUI. -->
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Maui" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\MusicMp3Downloader.Core.csproj" />
  </ItemGroup>

</Project>
