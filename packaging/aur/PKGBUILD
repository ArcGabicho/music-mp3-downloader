# Maintainer: ArcGabicho <pcjhonny13@gmail.com>
# Paquete binario: instala el ejecutable publicado en la GitHub Release.
# No compila .NET dentro del chroot de makepkg (dotnet restore necesita red).

pkgname=music-mp3-downloader-bin
_pkgname=music-mp3-downloader
pkgver=0.1.0
pkgrel=1
pkgdesc="Reproductor de música de escritorio que descarga audio de YouTube a MP3, 100% local"
arch=('x86_64')
url="https://github.com/ArcGabicho/music-mp3-downloader"
license=('MIT')
depends=('vlc' 'icu')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip')  # no tocar el bundle self-contained ni los binarios de yt-dlp/ffmpeg
source=("$_pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/MusicMp3Downloader-$pkgver-linux-x64.tar.gz"
        "$_pkgname.desktop"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/ArcGabicho/music-mp3-downloader/v$pkgver/LICENSE.md")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')
# Tras publicar la Release, ejecuta `updpkgsums` para reemplazar los SKIP por los hashes reales.

package() {
    install -dm755 "$pkgdir/opt/$_pkgname"
    cp -r "$srcdir/MusicMp3Downloader.App" "$srcdir/tools" "$pkgdir/opt/$_pkgname/"
    chmod +x "$pkgdir/opt/$_pkgname/MusicMp3Downloader.App"
    chmod +x "$pkgdir/opt/$_pkgname"/tools/*

    install -dm755 "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/$_pkgname" <<'EOF'
#!/bin/sh
exec /opt/music-mp3-downloader/MusicMp3Downloader.App "$@"
EOF
    chmod +x "$pkgdir/usr/bin/$_pkgname"

    install -Dm644 "$srcdir/$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
    install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
