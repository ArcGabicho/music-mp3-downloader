<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource BgRight}" />
    </Style>

    <!-- ============ TIPOGRAFÍA ============ -->
    <Style TargetType="Label" Class="brand">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="3" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="Label" Class="cardTitle">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style TargetType="Label" Class="cardSubtitle">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style TargetType="Label" Class="trackIndex">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="TextColor" Value="{StaticResource TextPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Label" Class="trackTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="TextColor" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontAttributes" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Label" Class="rowTime">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" Class="hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextFaintBrush}" />
    </Style>

    <!-- ============ FILA DE LA LISTA DE PISTAS ============ -->
    <Style TargetType="Border" Class="trackRow">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceActive}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============ BOTONES DE TEXTO ============ -->
    <Style TargetType="Button" Class="pill">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentBrush}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceActiveBrush}" />
                            <Setter Property="TextColor" Value="{StaticResource TextFaintBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ============ BOTONES DE ICONO (Border + Path + TapGestureRecognizer) ============ -->
    <Style TargetType="Border" Class="iconGhost">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="transport">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceActiveBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="transportMain">
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="BackgroundColor" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource TextPrimaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="White" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ============ TARJETA "REPRODUCIENDO AHORA" ============ -->
    <Style TargetType="Border" Class="avatarFrame">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceActive}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Border" Class="statusPill">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource HairlineBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- ============ CONTROLES BASE ============ -->
    <Style TargetType="Entry">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextFaintBrush}" />
    </Style>

    <Style TargetType="Border" Class="modal">
        <Setter Property="BackgroundColor" Value="{StaticResource Panel}" />
        <Setter Property="Stroke" Value="#22FFFFFF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Offset="0,10" Radius="40" Opacity="0.5" />
        </Setter>
    </Style>

    <Style TargetType="Border" Class="downloadCard">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

</ResourceDictionary>
