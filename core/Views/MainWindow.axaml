<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MusicMp3Downloader.App.ViewModels"
        xmlns:ctrl="using:MusicMp3Downloader.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        x:Class="MusicMp3Downloader.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Music MP3 Downloader"
        Width="1180" Height="720"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgRightBrush}">

    <Grid ColumnDefinitions="Auto,*">

        <!-- ============ PANEL IZQUIERDO / PORTADA ============ -->
        <Border Grid.Column="0" Width="430" IsVisible="{Binding IsWide}" ClipToBounds="True">
            <Panel>
                <Panel Background="{StaticResource ArtworkGradient}" />
                <Image Source="{Binding CoverArt}" Stretch="UniformToFill"
                       IsVisible="{Binding CoverArt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Panel Background="{StaticResource ArtworkScrim}" />

                <StackPanel Margin="36,32" VerticalAlignment="Top" HorizontalAlignment="Left"
                            Orientation="Horizontal" Spacing="11">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="9" Fill="White" />
                        <Rectangle Width="3" Height="16" Fill="White" />
                        <Rectangle Width="3" Height="6" Fill="White" />
                        <Rectangle Width="3" Height="12" Fill="White" />
                    </StackPanel>
                    <TextBlock Text="MUSIC MP3" Classes="brand" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Panel>
        </Border>

        <!-- ============ PANEL DERECHO / LISTA ============ -->
        <Border Grid.Column="1" Background="{StaticResource BgRightBrush}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="38,24,28,0" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="7" Fill="{StaticResource TextFaintBrush}" />
                        <Rectangle Width="3" Height="13" Fill="{StaticResource TextFaintBrush}" />
                        <Rectangle Width="3" Height="6" Fill="{StaticResource TextFaintBrush}" />
                        <Rectangle Width="3" Height="10" Fill="{StaticResource TextFaintBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="iconGhost" Command="{Binding ToggleDownloadPanelCommand}"
                            ToolTip.Tip="Descargar de YouTube">
                        <Path Data="M10,1 L10,19 M1,10 L19,10" Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="2" StrokeLineCap="Round" />
                    </Button>
                </Grid>

                <StackPanel DockPanel.Dock="Top" Margin="40,24,40,0" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding Player.HeaderArtist}" Classes="eyebrow" />
                        <TextBlock Text="/" Classes="eyebrow" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding Player.HeaderYear}" Classes="eyebrow"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Player.BigTitle}" Classes="h1"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LibraryStatus}" Classes="rowTime" />
                    <TextBlock Text="{Binding Player.StatusMessage}" Classes="rowTime"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding Player.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <!-- ===== barra de reproducción ===== -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
                        Padding="30,0" Height="94">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          VerticalAlignment="Center">

                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="nowLabel"
                                   Margin="20,0,20,8" HorizontalAlignment="Center"
                                   Text="{Binding Player.NowPlayingLabel, FallbackValue='SIN REPRODUCCIÓN'}" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Classes="transport" VerticalAlignment="Center"
                                    Command="{Binding Player.PreviousCommand}">
                                <Path Data="M0,0 L2.5,0 L2.5,14 L0,14 Z M13,0 L3,7 L13,14 Z"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="transportMain" VerticalAlignment="Center"
                                    Command="{Binding Player.PlayPauseCommand}">
                                <Panel Width="16" Height="16">
                                    <Path Data="M0,0 L13,8 L0,16 Z" Fill="{StaticResource BgRightBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"
                                          IsVisible="{Binding !Player.IsPlaying}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsVisible="{Binding Player.IsPlaying}">
                                        <Rectangle Width="4" Height="15" Fill="{StaticResource BgRightBrush}" />
                                        <Rectangle Width="4" Height="15" Fill="{StaticResource BgRightBrush}" />
                                    </StackPanel>
                                </Panel>
                            </Button>
                            <Button Classes="transport" VerticalAlignment="Center"
                                    Command="{Binding Player.NextCommand}">
                                <Path Data="M11.5,0 L14,0 L14,14 L11.5,14 Z M1,0 L11,7 L1,14 Z"
                                      Fill="{StaticResource TextPrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <ctrl:WaveformScrubber Grid.Row="1" Grid.Column="1" Height="34" Margin="20,0"
                                               VerticalAlignment="Center"
                                               Progress="{Binding Player.Progress}"
                                               Seed="{Binding Player.Seed}"
                                               IsScrubbing="{Binding Player.IsScrubbing, Mode=TwoWay}"
                                               SeekCommand="{Binding Player.SeekCommand}"
                                               PlayedBrush="{StaticResource AccentBrush}"
                                               RemainingBrush="{StaticResource TextFaintBrush}" />

                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center">
                            <Button Classes="transport" Width="34" Height="34" VerticalAlignment="Center"
                                    Command="{Binding Player.ToggleMuteCommand}">
                                <Panel Width="18" Height="16">
                                    <Path Data="M0,5 L4,5 L9,1 L9,15 L4,11 L0,11 Z"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Path Data="M12,5 L18,11 M18,5 L12,11" Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center"
                                          IsVisible="{Binding Player.IsMuted}" />
                                </Panel>
                            </Button>
                            <Slider Width="100" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                    Value="{Binding Player.Volume}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== lista de pistas ===== -->
                <ListBox x:Name="TrackList" Classes="tracks" Margin="24,20,14,10"
                         ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                         Tapped="OnTrackActivated"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackViewModel">
                            <Grid Classes.playing="{Binding IsPlaying}" ColumnDefinitions="30,46,*,Auto" Height="46">
                                <Panel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Path Data="M0,0 L9,5 L0,10 Z" Fill="{StaticResource TextFaintBrush}"
                                          IsVisible="{Binding !IsPlaying}" />
                                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding IsPlaying}">
                                        <Rectangle Width="3" Height="11" Fill="{StaticResource AccentBrush}" />
                                        <Rectangle Width="3" Height="11" Fill="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding IndexLabel}" Classes="rowIndex" />
                                <TextBlock Grid.Column="2" Text="{Binding Title}" Classes="rowTitle" />
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Classes="rowTime"
                                           Margin="14,0,8,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ OVERLAY DESCARGA ============ -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsDownloadPanelOpen}"
                Background="{StaticResource ScrimBrush}" Tapped="OnScrimTapped">
            <Border Classes="modal" Width="620" MaxHeight="470"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="DESCARGAR DE YOUTUBE" Classes="brand" />
                            <TextBlock Text="El MP3 se guarda en tu carpeta de música" Classes="hint" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="iconGhost" VerticalAlignment="Top"
                                Command="{Binding ToggleDownloadPanelCommand}">
                            <Path Data="M0,0 L13,13 M13,0 L0,13" Stroke="{StaticResource TextPrimaryBrush}"
                                  StrokeThickness="2" StrokeLineCap="Round" />
                        </Button>
                    </Grid>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,22,0,0">
                        <TextBox Grid.Column="0" Height="42" VerticalContentAlignment="Center"
                                 PlaceholderText="https://www.youtube.com/watch?v=…"
                                 Text="{Binding DownloadUrl}" />
                        <Button Grid.Column="1" Classes="pill" Content="Descargar" Margin="10,0,0,0"
                                Command="{Binding DownloadCommand}" IsDefault="True" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DownloadStatus}" Classes="rowTime"
                               Margin="2,12,0,0" />
                    <ScrollViewer Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding DownloadQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                                            Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{Binding Title}" Classes="rowTitle" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Status}" Classes="rowTime" />
                                                <ProgressBar Width="280" Minimum="0" Maximum="1"
                                                             Value="{Binding Progress}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>