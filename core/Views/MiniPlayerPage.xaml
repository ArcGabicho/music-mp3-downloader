<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MusicMp3Downloader.App.ViewModels;assembly=MusicMp3Downloader.Core"
             xmlns:conv="clr-namespace:MusicMp3Downloader.App.Converters"
             x:Class="MusicMp3Downloader.App.Views.MiniPlayerPage"
             x:DataType="vm:MainWindowViewModel"
             Title="Music MP3 Downloader">

    <ContentPage.Resources>
        <conv:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSource" />
        <conv:IsNotNullConverter x:Key="IsNotNull" />
        <conv:IsNullConverter x:Key="IsNull" />
        <conv:InvertedBoolConverter x:Key="InvertedBool" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="18" Spacing="16" BackgroundColor="{StaticResource Panel}">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Grid.Column="0" StyleClass="avatarFrame" WidthRequest="44" HeightRequest="44">
                <Grid>
                    <Ellipse Fill="{StaticResource Hairline}" WidthRequest="12" HeightRequest="12"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             IsVisible="{Binding Player.Current.CoverArtBytes, Converter={StaticResource IsNull}}" />
                    <Image Source="{Binding Player.Current.CoverArtBytes, Converter={StaticResource ByteArrayToImageSource}}"
                           Aspect="AspectFill"
                           IsVisible="{Binding Player.Current.CoverArtBytes, Converter={StaticResource IsNotNull}}" />
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="{Binding Player.NowPlayingTitle}" StyleClass="cardTitle" FontSize="14" />
                <Label Text="{Binding Player.NowPlayingSubtitle}" StyleClass="cardSubtitle" FontSize="11"
                       IsVisible="{Binding Player.NowPlayingSubtitle, Converter={StaticResource IsNotNull}}" />
            </VerticalStackLayout>
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Label Grid.Column="0" Text="{Binding Player.PositionText}" StyleClass="rowTime" MinimumWidthRequest="30" />
            <Slider x:Name="MiniSeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Player.Progress}"
                    DragStarted="OnSeekDragStarted" DragCompleted="OnSeekDragCompleted"
                    MinimumTrackColor="{StaticResource ProgressAccent}"
                    MaximumTrackColor="{StaticResource SurfaceActive}"
                    ThumbColor="{StaticResource ProgressAccent}" />
            <Label Grid.Column="2" Text="{Binding Player.DurationText}" StyleClass="rowTime" MinimumWidthRequest="30" />
        </Grid>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
            <Border StyleClass="transport">
                <Path Data="M0,0 L2.5,0 L2.5,14 L0,14 Z M13,0 L3,7 L13,14 Z" Fill="{StaticResource TextPrimaryBrush}"
                      HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Player.PreviousCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <Border StyleClass="transportMain">
                <Grid WidthRequest="18" HeightRequest="18">
                    <Path Data="M0,0 L13,8 L0,16 Z" Fill="{StaticResource BgRightBrush}"
                          HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,0"
                          IsVisible="{Binding Player.IsPlaying, Converter={StaticResource InvertedBool}}" />
                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center"
                                            IsVisible="{Binding Player.IsPlaying}">
                        <BoxView WidthRequest="4" HeightRequest="15" Color="{StaticResource BgRight}" />
                        <BoxView WidthRequest="4" HeightRequest="15" Color="{StaticResource BgRight}" />
                    </HorizontalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Player.PlayPauseCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <Border StyleClass="transport">
                <Path Data="M11.5,0 L14,0 L14,14 L11.5,14 Z M1,0 L11,7 L1,14 Z" Fill="{StaticResource TextPrimaryBrush}"
                      HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Player.NextCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
