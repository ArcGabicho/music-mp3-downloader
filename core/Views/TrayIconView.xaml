<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tb="https://notifyicon.com/"
             x:Class="MusicMp3Downloader.App.Views.TrayIconView"
             x:DataType="local:TrayIconView"
             xmlns:local="clr-namespace:MusicMp3Downloader.App.Views"
             WidthRequest="0" HeightRequest="0" InputTransparent="True">
    <tb:TaskbarIcon x:Name="TrayIcon"
                    IconSource="trayicon.ico"
                    ToolTipText="Music MP3 Downloader"
                    LeftClickCommand="{Binding ToggleMiniPlayerCommand}"
                    NoLeftClickDelay="True">
        <FlyoutBase.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Abrir ventana principal" Command="{Binding ShowMainWindowCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Salir" Command="{Binding ExitCommand}" />
            </MenuFlyout>
        </FlyoutBase.ContextFlyout>
    </tb:TaskbarIcon>
</ContentView>
