<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MusicMp3Downloader.App.ViewModels;assembly=MusicMp3Downloader.Core"
             xmlns:conv="clr-namespace:MusicMp3Downloader.App.Converters"
             x:Class="MusicMp3Downloader.App.Views.MainPage"
             x:Name="RootPage"
             x:DataType="vm:MainWindowViewModel"
             Title="Music MP3 Downloader">

    <ContentPage.Resources>
        <conv:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSource" />
        <conv:IsNotNullConverter x:Key="IsNotNull" />
        <conv:IsNullConverter x:Key="IsNull" />
        <conv:InvertedBoolConverter x:Key="InvertedBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ TARJETA "REPRODUCIENDO AHORA" ============ -->
        <Grid Grid.Row="0" Padding="24,20,24,16" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14"
              MaximumWidthRequest="860" HorizontalOptions="Fill">
            <Border Grid.Column="0" StyleClass="avatarFrame">
                <Grid>
                    <Ellipse Fill="{StaticResource Hairline}" WidthRequest="14" HeightRequest="14"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             IsVisible="{Binding Player.Current.CoverArtBytes, Converter={StaticResource IsNull}}" />
                    <Image Source="{Binding Player.Current.CoverArtBytes, Converter={StaticResource ByteArrayToImageSource}}"
                           Aspect="AspectFill"
                           IsVisible="{Binding Player.Current.CoverArtBytes, Converter={StaticResource IsNotNull}}" />
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding Player.NowPlayingTitle}" StyleClass="cardTitle" />
                <Label Text="{Binding Player.NowPlayingSubtitle}" StyleClass="cardSubtitle"
                       IsVisible="{Binding Player.NowPlayingSubtitle, Converter={StaticResource IsNotNull}}" />
            </VerticalStackLayout>

            <Border Grid.Column="2" StyleClass="statusPill" VerticalOptions="Center"
                    IsVisible="{Binding Player.NowPlayingSubtitle, Converter={StaticResource IsNotNull}}">
                <HorizontalStackLayout Spacing="6">
                    <Ellipse Fill="{StaticResource SuccessBrush}" WidthRequest="8" HeightRequest="8"
                             VerticalOptions="Center" />
                    <Label Text="Descargado" FontSize="12" TextColor="{StaticResource TextPrimaryBrush}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="3" StyleClass="iconGhost" VerticalOptions="Center">
                <Path Data="M10,1 L10,19 M1,10 L19,10" Stroke="{StaticResource TextPrimaryBrush}"
                      StrokeThickness="2" StrokeLineCap="Round"
                      HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDownloadPanelCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
        <BoxView Grid.Row="0" Color="{StaticResource Hairline}" HeightRequest="1" VerticalOptions="End" />

        <!-- ============ LISTA DE PISTAS ============ -->
        <Grid Grid.Row="1">
            <CollectionView Margin="12,8,12,8" ItemsSource="{Binding Tracks}" SelectionMode="None"
                            MaximumWidthRequest="860" HorizontalOptions="Center"
                            IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBool}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackViewModel">
                        <Border StyleClass="trackRow" HeightRequest="46">
                            <Grid ColumnDefinitions="40,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.PlayTrackCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0" Text="{Binding IndexLabel}" StyleClass="trackIndex" />
                                <Label Grid.Column="1" Text="{Binding Title}" StyleClass="trackTitle" />
                                <Label Grid.Column="2" Text="{Binding DurationText}" StyleClass="rowTime" Margin="14,0,4,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="40">
                        <Ellipse Stroke="{StaticResource HairlineBrush}" StrokeThickness="1.5"
                                 WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                        <Label Text="Tu biblioteca está vacía" StyleClass="cardSubtitle" HorizontalTextAlignment="Center" />
                        <Label Text="Descarga tu primera canción con el botón + de arriba" StyleClass="hint"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                Color="{StaticResource TextFaint}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- ============ BARRA DE REPRODUCCIÓN ============ -->
        <Grid Grid.Row="2" HeightRequest="86" BackgroundColor="{StaticResource Panel}">
            <BoxView Color="{StaticResource Hairline}" HeightRequest="1" VerticalOptions="Start" />
            <Grid Padding="24,0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="12"
                  MaximumWidthRequest="860" HorizontalOptions="Fill" VerticalOptions="Center">
                <Border Grid.Column="0" StyleClass="transport">
                    <Path Data="M0,0 L2.5,0 L2.5,14 L0,14 Z M13,0 L3,7 L13,14 Z"
                          Fill="{StaticResource TextPrimaryBrush}"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Player.PreviousCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border Grid.Column="1" StyleClass="transportMain">
                    <Grid WidthRequest="18" HeightRequest="18">
                        <Path Data="M0,0 L13,8 L0,16 Z" Fill="{StaticResource BgRightBrush}"
                              HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,0"
                              IsVisible="{Binding Player.IsPlaying, Converter={StaticResource InvertedBool}}" />
                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center"
                                                IsVisible="{Binding Player.IsPlaying}">
                            <BoxView WidthRequest="4" HeightRequest="15" Color="{StaticResource BgRight}" />
                            <BoxView WidthRequest="4" HeightRequest="15" Color="{StaticResource BgRight}" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Player.PlayPauseCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border Grid.Column="2" StyleClass="transport">
                    <Path Data="M11.5,0 L14,0 L14,14 L11.5,14 Z M1,0 L11,7 L1,14 Z"
                          Fill="{StaticResource TextPrimaryBrush}"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Player.NextCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Label Grid.Column="3" Text="{Binding Player.PositionText}" StyleClass="rowTime"
                       MinimumWidthRequest="34" HorizontalTextAlignment="End" />

                <Slider x:Name="SeekSlider" Grid.Column="4" VerticalOptions="Center"
                        Minimum="0" Maximum="1" Value="{Binding Player.Progress}"
                        DragStarted="OnSeekDragStarted" DragCompleted="OnSeekDragCompleted"
                        MinimumTrackColor="{StaticResource ProgressAccent}"
                        MaximumTrackColor="{StaticResource SurfaceActive}"
                        ThumbColor="{StaticResource ProgressAccent}" />

                <Label Grid.Column="5" Text="{Binding Player.DurationText}" StyleClass="rowTime"
                       MinimumWidthRequest="34" />

                <Border Grid.Column="6" StyleClass="transport" WidthRequest="34" HeightRequest="34">
                    <Grid WidthRequest="18" HeightRequest="16">
                        <Path Data="M0,5 L4,5 L9,1 L9,15 L4,11 L0,11 Z" Fill="{StaticResource TextSecondaryBrush}"
                              HorizontalOptions="Start" VerticalOptions="Center" />
                        <Path Data="M12,5 L18,11 M18,5 L12,11" Stroke="{StaticResource AccentBrush}"
                              StrokeThickness="2" StrokeLineCap="Round" VerticalOptions="Center"
                              IsVisible="{Binding Player.IsMuted}" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Player.ToggleMuteCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ OVERLAY DESCARGA ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsDownloadPanelOpen}">
            <Grid Background="{StaticResource ScrimBrush}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDownloadPanelCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

            <Border StyleClass="modal" WidthRequest="620" MaximumHeightRequest="470"
                    VerticalOptions="Center" HorizontalOptions="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                            <Label Text="DESCARGAR DE YOUTUBE" StyleClass="brand" />
                            <Label Text="El MP3 se guarda en tu carpeta de música" StyleClass="hint" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" StyleClass="iconGhost" VerticalOptions="Start">
                            <Path Data="M0,0 L13,13 M13,0 L0,13" Stroke="{StaticResource TextPrimaryBrush}"
                                  StrokeThickness="2" StrokeLineCap="Round"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleDownloadPanelCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,22,0,0">
                        <Entry Grid.Column="0" HeightRequest="42" VerticalOptions="Center"
                               Placeholder="https://www.youtube.com/watch?v=…"
                               Text="{Binding DownloadUrl}"
                               ReturnCommand="{Binding DownloadCommand}" />
                        <Button Grid.Column="1" StyleClass="pill" Text="Descargar" Margin="10,0,0,0"
                                HeightRequest="42" Command="{Binding DownloadCommand}" />
                    </Grid>

                    <Label Grid.Row="2" Text="{Binding DownloadStatus}" StyleClass="rowTime" Margin="2,12,0,0" />

                    <CollectionView Grid.Row="3" Margin="0,16,0,0" ItemsSource="{Binding DownloadQueue}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <Border StyleClass="downloadCard" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="7">
                                        <Label Text="{Binding Title}" FontSize="14"
                                               TextColor="{StaticResource TextPrimaryBrush}"
                                               LineBreakMode="TailTruncation" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsInProgress}">
                                            <Label Grid.Column="0" Text="{Binding StatusLabel}" StyleClass="rowTime"
                                                   VerticalOptions="Center" />
                                            <ProgressBar Grid.Column="1" Progress="{Binding Progress}"
                                                         VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding StatusLabel}" StyleClass="rowTime"
                                               IsVisible="{Binding IsInProgress, Converter={StaticResource InvertedBool}}" />
                                        <Label Text="{Binding ErrorMessage}" LineBreakMode="WordWrap"
                                               TextColor="{StaticResource AccentBrush}"
                                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
