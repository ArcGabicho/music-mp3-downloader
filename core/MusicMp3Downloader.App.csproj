<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- El TFM de Windows solo se agrega si el host que compila es Windows: el XAML
         nativo de Platforms/Windows/App.xaml pasa por XamlCompiler.exe (WindowsAppSDK),
         un binario de Windows que no corre en macOS/Linux bajo ningún concepto — ni con
         EnableWindowsTargeting, que solo habilita el *restore*, no la compilación. Mismo
         patrón que usa la plantilla oficial de "dotnet new maui". -->
    <TargetFrameworks>net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MusicMp3Downloader.App</RootNamespace>
    <AssemblyName>MusicMp3Downloader.App</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Music MP3 Downloader</ApplicationTitle>
    <ApplicationId>com.arcgabicho.musicmp3downloader</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Sin empaquetar: publicación como carpeta autónoma, sin MSIX. -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- ============ Herramientas externas empaquetadas (yt-dlp + ffmpeg) ============ -->
  <PropertyGroup>
    <BundleExternalTools Condition="'$(BundleExternalTools)' == ''">true</BundleExternalTools>
    <ExternalToolsRid Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</ExternalToolsRid>
    <ExternalToolsRid Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">osx-x64</ExternalToolsRid>
    <ExternalToolsSourceRoot>$(MSBuildProjectDirectory)/Tools</ExternalToolsSourceRoot>
    <ExternalToolsDir>$(ExternalToolsSourceRoot)/$(ExternalToolsRid)</ExternalToolsDir>
  </PropertyGroup>

  <Target Name="FetchExternalTools"
          BeforeTargets="Build;Publish"
          Condition="'$(BundleExternalTools)' == 'true' and '$(ExternalToolsRid)' != ''">
    <!-- Cada Exec comprueba yt-dlp Y ffmpeg por separado: si uno de los dos no se
         descargó (p. ej. por un fallo de red puntual), reintenta en el próximo build
         en vez de darlo por "ya resuelto" solo porque el otro binario sí existe. -->
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/yt-dlp')"
          Command="bash &quot;$(ExternalToolsSourceRoot)/fetch-tools.sh&quot; $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/ffmpeg')"
          Command="bash &quot;$(ExternalToolsSourceRoot)/fetch-tools.sh&quot; $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/yt-dlp.exe')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ExternalToolsSourceRoot)\fetch-tools.ps1&quot; -Rid $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows')) and !Exists('$(ExternalToolsDir)/ffmpeg.exe')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ExternalToolsSourceRoot)\fetch-tools.ps1&quot; -Rid $(ExternalToolsRid)"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="CopyExternalToolsToOutput" AfterTargets="Build" DependsOnTargets="FetchExternalTools" Condition="'$(BundleExternalTools)' == 'true' and Exists('$(ExternalToolsDir)')">
    <ItemGroup>
      <_ExternalToolFile Include="$(ExternalToolsDir)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExternalToolFile)" DestinationFolder="$(OutDir)tools"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyExternalToolsToPublish"
          AfterTargets="Publish"
          DependsOnTargets="FetchExternalTools"
          Condition="'$(BundleExternalTools)' == 'true' and Exists('$(ExternalToolsDir)')">
    <ItemGroup>
      <_ExternalToolFile Include="$(ExternalToolsDir)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExternalToolFile)" DestinationFolder="$(PublishDir)tools"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0C0C0F" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0C0C0F" BaseSize="128,128" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
  </ItemGroup>

  <!-- Ícono de bandeja del sistema: solo Windows (Mac Catalyst no tiene "bandeja",
       usa un paradigma distinto — ítem de la barra de menú — fuera de alcance). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="H.NotifyIcon.Maui" Version="2.4.1" />
  </ItemGroup>

  <!-- TrayIconView es una vista de MAUI (usa H.NotifyIcon.Maui), no de WinUI, así que NO
       puede vivir bajo Platforms/Windows/: el SDK de MAUI quita incondicionalmente todo
       .xaml bajo esa carpeta del item MauiXaml (asume que es XAML nativo de WinUI para
       XamlCompiler.exe, como App.xaml) — si se la deja ahí, XamlCompiler.exe intenta
       compilarla y falla en silencio (exit code 1, sin mensaje). Por eso vive en Views/
       junto al resto de páginas MAUI, y se excluye del build en Mac Catalyst aquí en vez
       de por ubicación de carpeta, ya que depende de H.NotifyIcon (solo Windows). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <MauiXaml Remove="Views\TrayIconView.xaml" />
    <Compile Remove="Views\TrayIconView.xaml.cs" />
    <None Include="Views\TrayIconView.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\core\MusicMp3Downloader.Core.csproj" />
  </ItemGroup>

</Project>
