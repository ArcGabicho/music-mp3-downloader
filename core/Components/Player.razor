@implements IDisposable

<div class="root">

    <!-- ============ TARJETA "REPRODUCIENDO AHORA" ============ -->
    <div class="header">
        <div class="avatar">
            @if (ViewModel.Player.Current?.CoverArtBytes is { Length: > 0 } cover)
            {
                <img src="@ToDataUri(cover)" alt="" />
            }
            else
            {
                <span class="avatar-dot"></span>
            }
        </div>
        <div class="header-text">
            <p class="title">@ViewModel.Player.NowPlayingTitle</p>
            @if (ViewModel.Player.NowPlayingSubtitle is { } subtitle)
            {
                <p class="subtitle">@subtitle</p>
            }
        </div>
        @if (ViewModel.Player.NowPlayingSubtitle is not null)
        {
            <span class="chip"><span class="chip-dot"></span>Descargado</span>
        }
        <button class="icon-ghost" title="Descargar de YouTube" @onclick="() => ViewModel.ToggleDownloadPanelCommand.Execute(null)">
            <svg viewBox="0 0 20 20"><path d="M10 1v18M1 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
    </div>

    <!-- ============ FORMA DE ONDA ============ -->
    <div class="waveform">
        @{
            var playedBars = (int)(ViewModel.Player.WaveformPeaks.Length * ViewModel.Player.Progress);
        }
        @for (var i = 0; i < ViewModel.Player.WaveformPeaks.Length; i++)
        {
            <span class="bar @(i < playedBars ? "played" : "")" style="height:@(Math.Round(14 + Math.Max(0f, ViewModel.Player.WaveformPeaks[i]) * 78))%"></span>
        }
    </div>
    <div class="waveform-times">
        <span>@ViewModel.Player.PositionText</span>
        <span>@ViewModel.Player.DurationText</span>
    </div>

    <!-- ============ LISTA DE PISTAS ============ -->
    <ul class="track-list">
        @if (ViewModel.IsLoading)
        {
            <div class="spinner"></div>
        }
        else if (ViewModel.Tracks.Count == 0)
        {
            <li class="empty">
                <div class="empty-title">Tu biblioteca está vacía</div>
                <div class="empty-hint">Descarga tu primera canción con el botón + de arriba</div>
            </li>
        }
        else
        {
            @foreach (var track in ViewModel.Tracks)
            {
                <li class="track-row @(track.IsPlaying ? "playing" : "")" @onclick="() => ViewModel.PlayTrackCommand.Execute(track)">
                    <span class="track-index">@track.IndexLabel</span>
                    <span class="track-title">@track.Title</span>
                    <span class="track-time">@track.DurationText</span>
                </li>
            }
        }
    </ul>

    <!-- ============ BARRA DE REPRODUCCIÓN ============ -->
    <div class="transport-bar">
        <button class="icon-btn" @onclick="() => ViewModel.Player.PreviousCommand.Execute(null)">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 20 9 12l10-8v16ZM7 4v16H5V4h2Z" /></svg>
        </button>
        <button class="play-btn" @onclick="() => ViewModel.Player.PlayPauseCommand.Execute(null)">
            @if (ViewModel.Player.IsPlaying)
            {
                <svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7L8 5Z" /></svg>
            }
        </button>
        <button class="icon-btn" @onclick="() => ViewModel.Player.NextCommand.Execute(null)">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="m5 4 10 8L5 20V4Zm12 0h2v16h-2V4Z" /></svg>
        </button>
        <input class="seek" type="range" min="0" max="1" step="0.001"
               value="@ViewModel.Player.Progress"
               style="background:linear-gradient(to right, rgba(255,255,255,.7) @(ViewModel.Player.Progress * 100)%, rgba(255,255,255,.1) @(ViewModel.Player.Progress * 100)%)"
               @oninput="OnSeekInput" @onchange="OnSeekCommit" />
        <button class="icon-btn" @onclick="() => ViewModel.Player.ToggleMuteCommand.Execute(null)">
            @if (ViewModel.Player.IsMuted)
            {
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3Z" /><path d="M15 9l6 6M21 9l-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3Zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.06A4.5 4.5 0 0 0 16.5 12Z" /></svg>
            }
        </button>
    </div>

    <!-- ============ OVERLAY DESCARGA ============ -->
    @if (ViewModel.IsDownloadPanelOpen)
    {
        <div class="scrim" @onclick="() => ViewModel.ToggleDownloadPanelCommand.Execute(null)"></div>
        <div class="modal">
            <div class="modal-header">
                <div>
                    <div class="brand">DESCARGAR DE YOUTUBE</div>
                    <div class="hint">El MP3 se guarda en tu carpeta de música</div>
                </div>
                <button class="icon-ghost" @onclick="() => ViewModel.ToggleDownloadPanelCommand.Execute(null)">
                    <svg viewBox="0 0 13 13"><path d="M0,0 L13,13 M13,0 L0,13" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
            </div>
            <div class="modal-input-row">
                <input type="text" placeholder="https://www.youtube.com/watch?v=…"
                       value="@ViewModel.DownloadUrl" @oninput="OnDownloadUrlChanged"
                       @onkeydown="OnDownloadUrlKeyDown" />
                <button class="pill" disabled="@(!ViewModel.DownloadCommand.CanExecute(null))"
                        @onclick="() => ViewModel.DownloadCommand.Execute(null)">Descargar</button>
            </div>
            <div class="row-time modal-status">@ViewModel.DownloadStatus</div>
            <div class="download-queue">
                @foreach (var item in ViewModel.DownloadQueue)
                {
                    <div class="download-card">
                        <div class="download-title">@item.Title</div>
                        @if (item.IsInProgress)
                        {
                            <div class="download-progress-row">
                                <span class="row-time">@item.StatusLabel</span>
                                <div class="progress-track"><div class="progress-fill" style="width:@(item.Progress * 100)%"></div></div>
                            </div>
                        }
                        else
                        {
                            <div class="row-time">@item.StatusLabel</div>
                        }
                        @if (item.ErrorMessage is { } error)
                        {
                            <div class="download-error">@error</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject]
    public MainWindowViewModel ViewModel { get; set; } = default!;

    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnAnyPropertyChanged;
        ViewModel.Player.PropertyChanged += OnAnyPropertyChanged;
        ViewModel.Tracks.CollectionChanged += OnAnyCollectionChanged;
        ViewModel.DownloadQueue.CollectionChanged += OnAnyCollectionChanged;
    }

    private void OnAnyPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnAnyCollectionChanged(object? sender, System.Collections.Specialized.NotifyCollectionChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnSeekInput(ChangeEventArgs e)
    {
        ViewModel.Player.IsScrubbing = true;
    }

    private void OnSeekCommit(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var fraction) && ViewModel.Player.SeekCommand.CanExecute(fraction))
        {
            ViewModel.Player.SeekCommand.Execute(fraction);
        }

        ViewModel.Player.IsScrubbing = false;
    }

    private void OnDownloadUrlChanged(ChangeEventArgs e) => ViewModel.DownloadUrl = e.Value?.ToString() ?? string.Empty;

    private void OnDownloadUrlKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && ViewModel.DownloadCommand.CanExecute(null))
        {
            ViewModel.DownloadCommand.Execute(null);
        }
    }

    private static string ToDataUri(byte[] bytes) => $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnAnyPropertyChanged;
        ViewModel.Player.PropertyChanged -= OnAnyPropertyChanged;
        ViewModel.Tracks.CollectionChanged -= OnAnyCollectionChanged;
        ViewModel.DownloadQueue.CollectionChanged -= OnAnyCollectionChanged;
    }
}
